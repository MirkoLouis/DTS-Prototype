{
    "name": "dict/dts",
    "description": "Document Tracking System (Pure PHP)",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "chillerlan/php-qrcode": "^6.0",
        "dompdf/dompdf": "^3.0",
        "symfony/cache": "^7.4",
        "openspout/openspout": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0
    },
    "scripts": {
        "test": "phpunit --testsuite unit,workflow,http",
        "test:security": "phpunit --testsuite security",
        "test:concurrency": "phpunit --testsuite concurrency --group concurrency",
        "bench": "phpunit --testsuite benchmark --group benchmark",
        "replay": "php scripts/route-replay.php",
        "manual:live-concurrency": "php scripts/manual/live-concurrency.php",
        "dev": "php scripts/dev.php",
        "prod": "php scripts/prod.php",
        "worker": "php console.php",
        "proxy": "cloudflared tunnel --url http://localhost:8000",
        "corrupt": "php scripts/corrupt.php",
        "seed:dev": "node scripts/seeders/seed.js",
        "seed:fast": "php scripts/seeders/fast-seed.php",
        "seed:prod": "node scripts/seeders/setup-production-db.js"
    }
}
