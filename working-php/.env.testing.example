# Test-suite environment. Copy to .env.testing; the suite refuses to run unless the database name ends in _test.
APP_ENV=testing
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deped_dts_test
DB_USERNAME=root
DB_PASSWORD=

# Short PIN cache so expiry tests do not wait long
PIN_CACHE_DURATION=2
APP_DEBUG=true

# Generate with: APP_ENV=testing php scripts/generate-keys.php --system
SYSTEM_SIGNING_SECRET=
SYSTEM_SIGNING_PUBLIC=
