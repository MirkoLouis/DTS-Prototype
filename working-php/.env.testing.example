# Test-suite environment. Copy to .env.testing; the suite refuses to run unless the database name ends in _test.
APP_ENV=testing
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deped_dts_test
DB_USERNAME=root
DB_PASSWORD=

# Short PIN cache so expiry tests do not wait long
PIN_CACHE_DURATION=2
APP_DEBUG=true

# Generate with: APP_ENV=testing php scripts/generate-keys.php --system
SYSTEM_SIGNING_SECRET=
SYSTEM_SIGNING_PUBLIC=

# Integrity key for the system audit log; generate with: APP_ENV=testing php scripts/generate-keys.php --integrity
APP_INTEGRITY_KEY=

# Backup archive password used by the backup tests
BACKUP_PASSWORD=test-backup-password

# Rate limiting stays on in the suite (RATE_LIMIT_ENABLED defaults to true). Suites that send more guest requests from one
# IP than the limits allow start their own server without it; with TEST_BASE_URL that external server needs RATE_LIMIT_ENABLED=false.
