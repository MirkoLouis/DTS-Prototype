DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deped_dts
DB_USERNAME=root
DB_PASSWORD=

# Lifetime in seconds of the encrypted browser PIN-cache token
PIN_CACHE_DURATION=72000

# Print PHP errors to the page (keep false on the deployed LAN server)
APP_DEBUG=false

# Server Ed25519 key for system-initiated log entries; generate with: php scripts/generate-keys.php --system
SYSTEM_SIGNING_SECRET=
SYSTEM_SIGNING_PUBLIC=

# Secret that keys the tamper-evident system audit log (storage/logs/system-audit.log); generate with:
#   php scripts/generate-keys.php --integrity
# Keep a copy away from this server. Never store it in the database.
APP_INTEGRITY_KEY=
# Queue jobs: seconds between a running job's health pings, and seconds without a ping before the job
# is recorded under Failed Jobs as abandoned (it is never retried automatically)
JOB_HEARTBEAT_SECONDS=10
JOB_ABANDONED_SECONDS=60

# Backups: days a backup is kept before it is deleted when a new backup is made. The newest backup
# always stays. 0 keeps every backup.
BACKUP_KEEP_DAYS=14
